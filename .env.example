# Medpark Offline Meeting Intelligence - example environment file
# Copy to .env (repository root). Every key maps 1:1 to backend/app/core/config.py.

# --- Application ---
ENVIRONMENT=development                 # development | production | test
DEBUG=false

# --- Storage (all local; derived dirs do NOT follow DATA_DIR automatically, override each one) ---
# DATA_DIR=F:/DEEPTECH/data
# UPLOADS_DIR=F:/DEEPTECH/data/uploads
# EXPORTS_DIR=F:/DEEPTECH/data/exports
# MODELS_DIR=F:/DEEPTECH/data/models
# FIXTURES_DIR=F:/DEEPTECH/data/fixtures

# --- ASR (faster-whisper) ---
WHISPER_MODEL_NAME=turbo
WHISPER_DEVICE=auto                     # cuda | cpu | auto
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_BEAM_SIZE=5
ALLOW_CPU_FALLBACK=false                # true only on machines without a usable GPU; a CUDA failure is otherwise loud
# Code-switching decode (see docs/ASR_CODE_SWITCHING.md): language is detected PER WINDOW, restricted to WHISPER_LANGUAGES
WHISPER_STRATEGY=windowed               # windowed | batched; "batched" only after a GPU measurement shows it wins (unmeasured)
WHISPER_LANGUAGES=["ro","ru","en"]      # the ONLY language tokens the decoder may choose; unrestricted LID translated Romanian to English
WHISPER_BATCH_SIZE=4                    # batched strategy only; larger batches cost VRAM the 4 GB card does not have
WHISPER_CHUNK_LENGTH_S=12               # batched strategy only; chunk length fed to BatchedInferencePipeline
ASR_WINDOW_MIN_S=1.5                    # a VAD chunk shorter than this is merged into the previous window
ASR_WINDOW_TARGET_S=12.0                # windows are packed towards this length (one encoder pass = 30 s regardless)
ASR_WINDOW_MAX_S=20.0                   # packing stops before exceeding this
ASR_WINDOW_HARD_CAP_S=28.0              # a single VAD chunk longer than this is cut; the encoder input is 30 s
ASR_LID_RESCORE_BELOW=0.70              # windows whose top restricted-language probability is below this get a 2-hypothesis decode
ASR_HOTWORDS_ENABLED=true               # per-language clinical hotwords (<= 80 tokens); replaces the old 257-token initial_prompt
ASR_LEXICON_ENABLED=true                # post-decode near-miss correction of drug/clinical names (original text kept in corrections[])
ASR_GARBAGE_LOGPROB=-1.5                # segment avg_logprob below this -> is_flagged "low_confidence_asr" (never deleted)
ASR_GARBAGE_COMPRESSION=2.4             # segment compression_ratio above this -> flagged (repetition loop)
ASR_GARBAGE_NO_SPEECH=0.85              # segment no_speech_prob above this -> flagged

# --- Local LLM extraction (Ollama native API; see docs/LLM_EXTRACTION.md) ---
LLM_PROVIDER=ollama                     # ollama | llama_cpp_server
LLM_API_BASE_URL=http://127.0.0.1:11434 # Ollama server; nothing leaves the host
LLM_MODEL_NAME=medpark-extractor        # alias created by deploy/scripts/setup_ollama.ps1 (Qwen3-4B-Instruct-2507 Q4_K_M)
LLM_TEMPERATURE=0.0                     # greedy decoding for reproducible minutes
LLM_SEED=1234                           # fixed seed; the repair attempt uses seed+1
LLM_CONTEXT_TOKENS=4096                 # num_ctx; sized to the 4 GB VRAM budget, not to the meeting length
LLM_MAX_TOKENS=1100                     # num_predict cap per call; a repetition loop cannot eat the context
LLM_REQUEST_TIMEOUT_S=240.0             # per /api/chat call
LLM_HEALTH_TIMEOUT_S=3.0                # /api/version + /api/tags probe; must never load the model
LLM_KEEP_ALIVE=10m                      # residency between calls of one meeting; the engine unloads after each meeting
REQUIRE_LOCAL_LLM=true                  # true: pipeline FAILS at preflight (3 s) when Ollama/model is not serving
LLM_FALLBACK_MODE=fail                  # fail | heuristic; heuristic only applies when REQUIRE_LOCAL_LLM=false and stamps is_degraded
LLM_CHUNK_TOKENS=2300                   # map/reduce chunk budget (indexed transcript lines, never split mid-line)
LLM_CHUNK_OVERLAP_TOKENS=200            # lines re-shown from the previous chunk; items ending inside the overlap are dropped
LLM_CHARS_PER_TOKEN=2.0                 # conservative RO/RU/EN estimate used by the chunker
LLM_MAX_REPAIR_ATTEMPTS=1               # one Romanian repair turn per failed chunk before it is counted as failed
LLM_MAX_FAILED_CHUNK_RATIO=0.20         # above this ratio the extraction raises instead of shipping a partial draft

# --- Delivery: keep SMTP local (Mailpit). NEVER point this at the hospital relay while testing. ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=minutes@medpark.md
SMTP_FROM_NAME=Medpark Meeting Intelligence
ALLOW_SIMULATED_DELIVERY=false          # false: an unreachable SMTP host is reported as FAILED, never as "sent"

DELIVERY_CHANNEL=smtp                   # smtp | n8n (mutually exclusive)
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/medpark-mom
N8N_ENABLED=false

# --- Speaker identity (CAM++ voiceprints on CPU; see docs/VOICE_PROFILES.md) ---
# Voiceprints are biometric data: .npy files under VOICEPRINTS_DIR only, never inside a JSON store.
# A name reaches a document only after a reviewer confirms a cluster; nothing here changes that.
VOICE_ID_ENABLED=true                   # feature flag; /ready reports it together with embedder availability
# VOICEPRINTS_DIR=F:/DEEPTECH/data/voiceprints
# SPEAKER_EMBEDDER_MODEL_PATH=F:/DEEPTECH/data/models/speaker/campplus/voxceleb_CAM++_LM.onnx
SPEAKER_CLUSTER_DISTANCE=0.45           # average-linkage cosine-distance stop (measured on real far-field audio; 0.55 merges speakers)
SPEAKER_WINDOW_MAX_S=8.0                # VAD speech regions are cut into windows of at most this many seconds
SPEAKER_MATCH_MIN_SCORE=0.50            # below this cosine no name is offered at all
SPEAKER_MATCH_MIN_MARGIN=0.08           # top1 - top2 must exceed this before a suggestion is shown
SPEAKER_MIN_PRINTABLE_SPEECH_S=2.0      # a name prints on a segment only with at least this much VAD speech
SPEAKER_MIN_ENROLL_SPEECH_S=20.0        # total speech across samples before an enrollment is accepted
SPEAKER_MIN_SAMPLE_SPEECH_S=4.0         # a single sample with less speech is rejected and stores nothing
SPEAKER_MIN_COHESION=0.55               # mean pairwise cosine across a person's samples
ALLOW_AUTO_CONFIRM_SPEAKERS=false       # must stay false: there is no code path that confirms a speaker without a reviewer

# --- Offline inference hygiene (read by huggingface_hub / transformers, not by config.py) ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# --- Ollama server process (set in the environment that launches `ollama serve`, not read by the app) ---
# OLLAMA_FLASH_ATTENTION=1              # required with num_gpu 37 so the full model fits in 4 GB
# OLLAMA_KV_CACHE_TYPE=q8_0             # halves the KV cache; required for 100% GPU residency at num_ctx 4096
